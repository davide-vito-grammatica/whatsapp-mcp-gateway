# Generate a new secret locally (at least 32 characters), never commit .env.
MCP_AUTH_TOKEN=
# Exact trusted HTTPS image hosts, comma-separated. Empty rejects legacy URL sends.
MCP_IMAGE_ALLOWED_HOSTS=
# Optional immutable tag/digest override; default image is published by Actions.
WHATSAPP_MCP_IMAGE=ghcr.io/davide-vito-grammatica/whatsapp-mcp-gateway-mcp:3.0.0
MCP_ALLOWED_HOSTS=localhost:*,127.0.0.1:*,whatsapp-mcp:*
MCP_ALLOWED_ORIGINS=
# ChatGPT file staging: 15 MiB default, capped at 20 MiB; TTL 60..3600 seconds.
MCP_IMAGE_MAX_BYTES=15728640
MCP_IMAGE_TTL_SECONDS=300

# Separate administrative secret (at least 32 random characters); never reuse MCP_AUTH_TOKEN.
# Required for QR, pairing and all administrative operations.
WHATSAPP_ADMIN_TOKEN=

# Backend HTTP API token: separate from both admin and external MCP tokens.
WHATSAPP_API_TOKEN=
# Exact HTTPS media host allowlist. Empty disables external URL downloads.
MEDIA_ALLOWED_HOSTS=
# Optional trusted browser origins. Same-origin management UI works by default.
WHATSAPP_ALLOWED_ORIGINS=
